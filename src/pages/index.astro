---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const pinnedProjects = allProjects.filter(
  (project) => project.data.pinned
);
---

<BaseLayout title="ForgottenScream — Portfolio">
  <section class="intro">
    <div class="intro-text">
      <h1>Software Engineer</h1>
      
      <h4>Computer Science Graduate | Linux & Open-Source Enthusiast | Backend / 
          DevOps / Security Interests</h4>
      
      <p> This year I graduate from my CS degree from the University of Kent with
        a passion for UNIX based operating systems, networking and software development.
        I love tinkering, creating scripts and using various programming languages
        to solve problems.
      </p>
      <p> I am also passionate about open-source technologies and am currently looking
          for opportunities to grow professionally in software development, DevOps or
          networking, while continuing to expand my technical skills and industry experience.
      </p>

      <p> This site links directly to the projects I’m actively working on. </p>

      <a href="/projects" class="btn btn-secondary">View Projects →</a>
    </div>
    <div class="intro-image">
      <img
          src="/images/pages/index/developer.png"
          alt="Developer working illustration"
      />
    </div>
  </section>
  <section class="pinned-projects">
    <h2>Pinned Projects</h2>

    <div class="project-grid">
      {pinnedProjects.map((project) => (
        <article class="project-card">
          <h3>{project.data.title}</h3>

          {project.data.image && (
            <img
              src={project.data.image}
              alt={`Screenshot of ${project.data.title}`}
              loading="lazy"
            />
          )}

          <p>{project.data.description}</p>

          {project.data.status && (
            <p><strong>Status:</strong> {project.data.status}</p>
          )}

          <div class="project-links">
            {project.data.site && (
              <a href={project.data.site} target="_blank" class="btn btn-secondary">
                Live Site →
              </a>
            )}
            <a href={project.data.repo} target="_blank" class="btn btn-secondary">
              GitHub →
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
