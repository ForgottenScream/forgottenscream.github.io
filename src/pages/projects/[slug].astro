---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { 
      project,
      index,
      slugs: projects.map((p) => p.slug),
    },
  }));
}

const { project, index, slugs } = Astro.props;

const prevSlug = index > 0 ? slugs[index - 1] : null;
const nextSlug = index < slugs.length - 1 ? slugs[index + 1] : null;

const { Content } = await project.render();
---

<BaseLayout title={`${project.data.title} — Project`}>
  <article class="project-detail">
    <a href="/projects" class="btn btn-secondary back-btn">
      ← Back to projects
    </a>

    <h2>{project.data.title}</h2>

    {project.data.image && (
      <img
        src={project.data.image}
        alt={`Screenshot of ${project.data.title}`}
      />
    )}

    <p>{project.data.description}</p>

    <div class="project-links">
      {project.data.site && (
        <a href={project.data.site} class="btn btn-secondary" target="_blank">
          Site
        </a>
      )}
      <a href={project.data.repo} class="btn btn-secondary" target="_blank">
        GitHub
      </a>
    </div>

    <hr />

    <div class="project-content">
      <Content />
    </div>
    <nav class="project-nav">
      {prevSlug && (
        <a href={`/projects/${prevSlug}`} class="btn btn-secondary">
          ← Previous
        </a>
      )}

      {nextSlug && (
        <a href={`/projects/${nextSlug}`} class="btn btn-secondary">
          Next →
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
