---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<BaseLayout title="Projects — ForgottenScream">
  <h2>Projects</h2>

  <section class="project-list">
    {projects.map((project) => (
      <article class="project-card">

        <h3>{project.data.title}</h3>

        <p>{project.data.description}</p>
        {project.data.image && (
          <img
              src={project.data.image}
              alt={`Screenshot of ${project.data.title}`}
              loading="lazy"
          />
         )}
        <div class="project-links">
          <a href={`/projects/${project.slug}`} class="btn">
            Read →
          </a>

          {project.data.site && (
            <a href={project.data.site} target="_blank" class="btn btn-secondary">
              Live Site →
            </a>
          )}
          <a href={project.data.repo} target="_blank" class="btn btn-secondary">
            View on GitHub →
          </a>
        </div>
        {project.data.status && <p>Status: {project.data.status}</p>}
      </article>
    ))}
  </section>
</BaseLayout>
