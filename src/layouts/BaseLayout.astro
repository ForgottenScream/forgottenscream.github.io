---
const { title = "Portfolio" } = Astro.props;
import "../styles/global.css";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Software portfolio of ForgottenScream" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header container">
      <h1 class="site-title">
        <a href="/">ForgottenScream</a>
      </h1>
      <nav>
        <a href="/projects">Projects</a>
        <a href="https://github.com/ForgottenScream" target="_blank">GitHub</a>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="container">
      <p>© {new Date().getFullYear()} ForgottenScream</p>
    </footer>
  </body>
</html>
